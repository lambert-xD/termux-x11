# Wayland core library CMake recipe for Android NDK
# Builds libwayland-server and libwayland-client as static libraries

# Generate version header
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/wayland/wayland/meson.build" MESON_BUILD)
string(REGEX MATCH "version[ ]*:[ ]*'([0-9]+\\.[0-9]+\\.[0-9]+)'" VERSION_MATCH "${MESON_BUILD}")
set(WAYLAND_VERSION "${CMAKE_MATCH_1}")
if(NOT WAYLAND_VERSION)
    set(WAYLAND_VERSION "1.25.90")
endif()
string(REPLACE "." ";" VERSION_LIST ${WAYLAND_VERSION})
list(GET VERSION_LIST 0 WAYLAND_VERSION_MAJOR)
list(GET VERSION_LIST 1 WAYLAND_VERSION_MINOR)
list(GET VERSION_LIST 2 WAYLAND_VERSION_MICRO)

file(GENERATE
    OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/wayland-version.h"
    CONTENT "#ifndef WAYLAND_VERSION_H\n#define WAYLAND_VERSION_H\n\n#define WAYLAND_VERSION_MAJOR ${WAYLAND_VERSION_MAJOR}\n#define WAYLAND_VERSION_MINOR ${WAYLAND_VERSION_MINOR}\n#define WAYLAND_VERSION_MICRO ${WAYLAND_VERSION_MICRO}\n#define WAYLAND_VERSION \"${WAYLAND_VERSION}\"\n\n#endif\n")

# Generate config.h for Android
file(GENERATE
    OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h"
    CONTENT "#ifndef WAYLAND_CONFIG_H\n#define WAYLAND_CONFIG_H\n\n#define PACKAGE \"wayland\"\n#define PACKAGE_VERSION \"${WAYLAND_VERSION}\"\n#define HAVE_SYS_PRCTL_H 1\n#define HAVE_POSIX_FALLOCATE 1\n#define HAVE_MEMFD_CREATE 1\n#define HAVE_STRNDUP 1\n#define HAVE_ACCEPT4 1\n#define HAVE_MREMAP 0\n#define HAVE_MKOSTEMP 1\n#define HAVE_BROKEN_MSG_CMSG_CLOEXEC 0\n#define _POSIX_C_SOURCE 200809L\n\n#endif\n")

set(WAYLAND_SRC_DIR "${CMAKE_CURRENT_SOURCE_DIR}/wayland/wayland/src")
set(WAYLAND_PROTOCOL_DIR "${CMAKE_CURRENT_SOURCE_DIR}/wayland/wayland/protocol")

# wayland-util library
add_library(wayland-util STATIC
    "${WAYLAND_SRC_DIR}/wayland-util.c")
target_include_directories(wayland-util PRIVATE
    "${WAYLAND_SRC_DIR}"
    "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_options(wayland-util PRIVATE
    "-fvisibility=hidden"
    "-include" "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h")

# wayland-os (object library for shared code)
add_library(wayland-os OBJECT
    "${WAYLAND_SRC_DIR}/wayland-os.c")
target_include_directories(wayland-os PRIVATE
    "${WAYLAND_SRC_DIR}"
    "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_options(wayland-os PRIVATE
    "-fvisibility=hidden"
    "-include" "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h")

# wayland-server library
add_library(wayland-server STATIC
    "${WAYLAND_SRC_DIR}/wayland-server.c"
    "${WAYLAND_SRC_DIR}/wayland-shm.c"
    "${WAYLAND_SRC_DIR}/event-loop.c"
    "${WAYLAND_SRC_DIR}/connection.c"
    $<TARGET_OBJECTS:wayland-os>)
target_include_directories(wayland-server PUBLIC
    "${WAYLAND_SRC_DIR}"
    "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_options(wayland-server PRIVATE
    "-fvisibility=hidden"
    "-include" "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h"
    "-DWL_HIDE_DEPRECATED")
target_link_libraries(wayland-server PUBLIC wayland-util)

# wayland-client library
add_library(wayland-client STATIC
    "${WAYLAND_SRC_DIR}/wayland-client.c"
    "${WAYLAND_SRC_DIR}/wayland-os.c"
    $<TARGET_OBJECTS:wayland-os>)
target_include_directories(wayland-client PUBLIC
    "${WAYLAND_SRC_DIR}"
    "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_options(wayland-client PRIVATE
    "-fvisibility=hidden"
    "-include" "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h"
    "-DWL_HIDE_DEPRECATED")
target_link_libraries(wayland-client PUBLIC wayland-util)

# wayland-scanner (host tool - only build if not cross-compiling, otherwise use prebuilt)
# For Android builds, we typically need a host wayland-scanner
# This is a simplified version; in practice you may need to build separately
if(NOT CMAKE_CROSSCOMPILING)
    find_package(EXPAT REQUIRED)
    add_executable(wayland-scanner
        "${WAYLAND_SRC_DIR}/scanner.c")
    target_include_directories(wayland-scanner PRIVATE
        "${WAYLAND_SRC_DIR}"
        "${WAYLAND_PROTOCOL_DIR}"
        "${CMAKE_CURRENT_BINARY_DIR}")
    target_compile_options(wayland-scanner PRIVATE
        "-include" "${CMAKE_CURRENT_BINARY_DIR}/wayland-config.h")
    target_link_libraries(wayland-scanner EXPAT::EXPAT wayland-util)
endif()

# Apply Android compatibility patches
target_apply_patch(wayland-server "${CMAKE_CURRENT_SOURCE_DIR}/wayland/wayland" "${CMAKE_CURRENT_SOURCE_DIR}/patches/wayland-android.patch")
